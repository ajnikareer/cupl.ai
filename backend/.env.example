# ================= core =================
APP_ENV=live
GCP_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
FIRESTORE_DB=(default)
ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
APP_TZ=Asia/Kolkata
PORT=8080

# ================= models (verify names in Vertex AI Model Garden) =================
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_AGENT_MODEL=gemini-2.5-flash
GEMINI_PLANNER_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# 0 = no thinking (lowest latency) for the text agent; -1 = model default
AGENT_THINKING_BUDGET=0

# ================= voice =================
LIVE_VOICE_NAME=Aoede
LIVE_LANGUAGE=
LIVE_AFFECTIVE_DIALOG=true
LIVE_PROACTIVE_AUDIO=true
# turn-taking: HIGH start sensitivity = quick barge-in; LOW end sensitivity = lets people pause & think
LIVE_START_SENSITIVITY=HIGH
LIVE_END_SENSITIVITY=LOW
LIVE_SILENCE_MS=700
LIVE_PREFIX_PADDING_MS=150

# ================= QLOO =================
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=PUT_YOUR_QLOO_KEY_HERE
QLOO_TIMEOUT_S=8
QLOO_CACHE_TTL_H=24
DEFAULT_REGION=India

# ================= WeaveWed MCP server =================
# agent -> tools transport: mcp (default) | inprocess
AGENT_TOOL_TRANSPORT=mcp
# leave empty to use http://127.0.0.1:$PORT/mcp/
MCP_URL=
MCP_INTERNAL_TOKEN=change-me-long-random-string

# ================= jobs =================
LEARN_EVERY_N_TURNS=4
CRON_SECRET=change-me-long-random-string
